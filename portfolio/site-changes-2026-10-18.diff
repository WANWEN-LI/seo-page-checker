+(()=>{const vids=[...document.querySelectorAll('video[data-loop]')];if(!vids.length)return;const rm=matchMedia('(prefers-reduced-motion: reduce)');const visible=new Set();const play=v=>{v.preload='auto';v.play().catch(()=>{})};const stop=v=>{v.pause();if(rm.matches){try{v.currentTime=0}catch(e){}}};const sync=()=>vids.forEach(v=>(visible.has(v)&&!rm.matches)?play(v):stop(v));if(!('IntersectionObserver' in window)){vids.forEach(v=>visible.add(v));sync();}else{const io=new IntersectionObserver(es=>{es.forEach(e=>e.isIntersecting?visible.add(e.target):visible.delete(e.target));sync()},{rootMargin:'200px 0px'});vids.forEach(v=>io.observe(v));}rm.addEventListener&&rm.addEventListener('change',sync)})();
